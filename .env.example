# Copy this file to .env and fill in your values

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: customize how the bot talks. Leave unset to use the default persona.
BOT_PERSONA=You are a friendly, casual texter. Keep replies short (1-3 sentences), warm, and natural, like a real friend texting on WhatsApp. Don't mention that you are an AI unless directly asked.

# Optional: Gemini model name. Defaults to gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash
